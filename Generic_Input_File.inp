% Geodetic Bayesian Inversion Software - BULK (GBIS-BULK)
% Adapted from the original software GBIS by Ben Ireland, University of Bristol, 2025
% Email: jl20461@bristol.ac.uk
% See below for original license information
% =========================================================================
% Geodetic Bayesian Inversion Software (GBIS)
% Software for the Bayesian inversion of geodetic data.
% Copyright: Marco Bagnardi, 2018
%
% Email: gbis.software@gmail.com
%
% Reference: 
% Bagnardi M. & Hooper A, (2018). 
% Inversion of surface deformation data for rapid estimates of source 
% parameters and uncertainties: A Bayesian approach. Geochemistry, 
% Geophysics, Geosystems, 19. https://doi.org/10.1029/2018GC007585
%
% =========================================================================
% Last update: 8 August, 2018

%% INPUT FILE

%% Reference point and Area of interest
geo.referencePoint = [1.0000;2.0000];    % Longitude and Latitude in degrees for arbitrary reference point of local coordinates system [Lon; Lat;]
geo.boundingBox = [1.0000;2.0000;3.0000;4.0000;];  % Coordinates in degrees of upper left and lower right limits of area of interest [UL_Lon,UL_Lat,LR_Lon,LR_Lat]

%% SUBSAMPLING STYLE
geo.SS_Factor = 15; 	%The downsampling factor of the coarse areas
geo.SS_FactorF = 4;	%The downsampling factor of the fine sampled areas
geo.QT =0;

%% Optional Parameters
modelInput.Const.step = 1e-3;
modelInput.Const.lower = -1e-1;
modelInput.Const.upper = 1e-1;
modelInput.Ramp.step = 0;
modelInput.Ramp.lower = 0;
modelInput.Ramp.upper = 0;

%% InSAR data
% Make sure insarID is unique!

insarID = 1;                            % InSAR dataset unique identifier

insar{insarID}.dataPath = 'random_dsc.mat'; % Path to data file

insar{insarID}.rawDataPath = 'random_dsc2.mat'; % Path to data file without downsampling (for figures)

insar{insarID}.wavelength = 0.056;      % Wavelength in m (e.g., Envisat/ERS/Sentinel: 0.056; CSK/TSX/TDX: 0.031)

insar{insarID}.constOffset = 'y';       % Remove constant offset? 'y' or 'n'

insar{insarID}.rampFlag = 'y';          % Remove linear ramp? 'y' or 'n'

insar{insarID}.sillExp = 1.9369e-05;       % Variogram sill in m^2

insar{insarID}.range = 1666.4406;            % Variogram range in m

insar{insarID}.nugget = 1.0249e-05;         % Variogram nugget in m

insar{insarID}.quadtreeThresh = 0.005^2; % Quadtree threshold variance (e.g., 0.01^2 m or 1e-04 m)

insarID = 2;                            % InSAR dataset unique identifier

insar{insarID}.dataPath = 'random_asc.mat'; % Path to data file

insar{insarID}.rawDataPath = 'random_asc2.mat'; % Path to data file without downsampling (for figures)

insar{insarID}.wavelength = 0.056;      % Wavelength in m (e.g., Envisat/ERS/Sentinel: 0.056; CSK/TSX/TDX: 0.031)

insar{insarID}.constOffset = 'y';       % Remove constant offset? 'y' or 'n'

insar{insarID}.rampFlag = 'y';          % Remove linear ramp? 'y' or 'n'

insar{insarID}.sillExp = 1.9369e-05;       % Variogram sill in m^2

insar{insarID}.range = 1666.4406;            % Variogram range in m

insar{insarID}.nugget = 1.0249e-05;         % Variogram nugget in m

insar{insarID}.quadtreeThresh = 0.005^2; % Quadtree threshold variance (e.g., 0.01^2 m or 1e-04 m)

%% Model parameters

modelInput.nu = 0.25;     % Poisson's ratio (Shear modulus is set to 1)

% Mogi 'M'
%                             X       Y      Z      DV
modelInput.mogi.start = [15000;-20000;2500;1000000;];      % starting model
modelInput.mogi.step =  [50;50;100;100000;];      % initial maximium step size
modelInput.mogi.lower = [0;-30000;100;100;];      % lower bounds on m
modelInput.mogi.upper = [25000;-10000;10000;1000000000;];      % upper bounds on m

% Rectangular dipping dike (Okada) 'D'
%                            L       W      Z     Dip    Str      X       Y     Op
modelInput.dike.start = [1000;5000;2000;89;45;25000;25000;1.0;];    % starting model
modelInput.dike.step =  [100;100;100;5;2;50;50;0.10;];    % initial maximium step size
modelInput.dike.lower = [ 100;100;1000;80;30;15000;15000;-2.0;];    % lower bounds on m
modelInput.dike.upper = [10000;10000;10000;90;60;35000;35000;2;];    % upper bounds on m

% Rectangular fault (Okada) 'F'
%                            L       W      Z     Dip     Str      X       Y      SS       DS
modelInput.fault.start = [ 7000;   5000;   2500;  -75.0;   270;  -5000;  3000;   1.0;     1.0;];    % starting model
modelInput.fault.step =  [  100;    100;   100;      1;     1;    50;    50;  0.01;    0.01;];    % initial maximium step size
modelInput.fault.lower = [  100;    100;   100;  -89.9;   180;   -10000;  -2500; -10.0;   -10.0;];    % lower bounds on m
modelInput.fault.upper = [10000;  10000; 10000;   -0.1;   360;  15000;    10000;  10.0;    10.0;];    % upper bounds on m

% McTigue 'T'
%                                X       Y      Z     R   DP/mu
modelInput.mctigue.start = [ -5000;   3000;  2500; 3500; 0.001; ];  % starting model
modelInput.mctigue.step =  [   100;    50;   100;    100;   0.0001; ];  % initial maximium step size
modelInput.mctigue.lower = [-10000; -20000;   100; 2700;   0.0001; ];  % lower bounds on m
modelInput.mctigue.upper = [ 15000;  10000; 10000; 4500;    1000; ];  % upper bounds on m

% Penny-shaped crack 'P'
%                              X       Y      Z     R    DP/mu
modelInput.penny.start = [-5000;3000;2500;3500;0.001;];    % starting model
modelInput.penny.step =  [100;50;100;100;0.0001;];    % initial maximium step size
modelInput.penny.lower = [-10000;-2500;500;2700;0.0001;];    % lower bounds on m
modelInput.penny.upper = [15000;10000;10000;4500;1000;];    % upper bounds on m

% Yang 'Y'
%                             X       Y      Z      a     a/b  Str    Pln    DP/mu
modelInput.yang.start = [   -5000;  3000;  2500;   500;    0.5; 270; -89.9; 0.0001;];    % starting model
modelInput.yang.step =  [   100;    100;    50;    50;    0.01;   1;     1;  0.0001;];    % initial maximium step size
modelInput.yang.lower = [-10000; -2500;  1000;     1;   0.01;   1; -89.9;   0.001;];    % lower bounds on m
modelInput.yang.upper = [ 15000;  10000; 10000; 20000;   0.99; 359;  -0.1;    1000;];    % upper bounds on m

% Horizontal rectangular sill (Okada) 'S'
%                            L     W      Z   Str     X      Y    Op
modelInput.sill.start = [ 7000; 5000;  2500;  270;-5000;  3000;   1;]; % starting model
modelInput.sill.step  = [   100;   100;  100;  10;  50;   50;    0.01;];  % initial maximium step size
modelInput.sill.lower = [  100;  100;   100;    1;-10000; -25;  0.05;];  % lower bounds on m
modelInput.sill.upper = [10000;10000; 10000;  359; 15000;  10000; 10;];  % upper bounds on m

% Hinged double dike (custum made) 'H'
%                           X_1     Y_1     L_1     W_1     Z_1    Dip_1     Op_1    W_2   Dip_2  Op_2  Strike
modelInput.hing.start = [   100;    100;   1000;   1000;     10;   -85.0;    0.5;  1000;   -10.0;  0.5;    30;]; % starting model
modelInput.hing.step =  [   100;    100;    100;    100;    100;       1;   0.01;   100;       1; 0.01;     1;]; % initial maximium step size
modelInput.hing.lower = [  -200;   -200;    100;    100;      1;   -89.9;   0.01;   100;   -89.9; 0.01;     1;]; % lower bounds on m
modelInput.hing.upper = [   200;    200;   7000;   7000;    200;    -0.1;   10.0;  9000;   -0.01; 10.0;   359;]; % upper bounds on m

% Sun 1969 Penny crack (pressure) 'C'
%                              X       Y      Z     R    DP/mu
modelInput.SunCrack.start = [     0;      0;  2000; 1000; 0.001; ];    % starting model
modelInput.SunCrack.step =  [   100;    100;    50;  100; 0.0001; ];    % initial maximium step size
modelInput.SunCrack.lower = [-20000; -20000;   100;  100; 0.0001; ];    % lower bounds on m
modelInput.SunCrack.upper = [ 20000;  20000; 30000; 2000;  1000; ];    % upper bounds on m

% Sun 1969 Penny crack (volume) 'V'
%                              X       Y      Z     R    DV
modelInput.SunVCrack.start = [     0;      0;  2000; 1000; 1000000; ];    % starting model
modelInput.SunVCrack.step =  [   100;    100;    50;  100; 100000; ];    % initial maximium step size
modelInput.SunVCrack.lower = [-20000; -20000;   100;  100; 100; ];    % lower bounds on m
modelInput.SunVCrack.upper = [ 20000;  20000; 30000; 2000; 1000000000; ];    % upper bounds on m

% Cervelli Yang (Volume) 'E'
%                           VertD    HorzD   Pln   Trend    X    Y    Z      dV
modelInput.cerv.start = [   -5000;  3000;  2500;   500;    0.5; 270; -89.9; 0.0001;];    % starting model
modelInput.cerv.step =  [   50;    50;    1;    1;    100;   100;  50;  10000;];    % initial maximium step size
modelInput.cerv.lower = [-10000; -2500;  1000;     1;   0.01;   1; -89.9;   0.001;];    % lower bounds on m
modelInput.cerv.upper = [ 15000;  10000; 10000; 20000;   0.99; 359;  -0.1;    1000;];    % upper bounds on m

% Cervelli Yang (Pressure) 'R'
%                           VertD    HorzD   Pln   Trend    X    Y    Z      DP/mu
modelInput.cerp.start = [   -5000;  3000;  2500;   500;    0.5; 270; -89.9; 0.0001;];    % starting model
modelInput.cerp.step =  [   50;    50;    1;    1;    100;   100;  50;  0.0001;];    % initial maximium step size
modelInput.cerp.lower = [-10000; -2500;  1000;     1;   0.01;   1; -89.9;   0.001;];    % lower bounds on m
modelInput.cerp.upper = [ 15000;  10000; 10000; 20000;   0.99; 359;  -0.1;    1000;];    % upper bounds on m

% Nikkhoo 2017 CDM 'A'
%                        X0  Y0  depth omegaX omegaY omegaZ ax ay az opening
modelInput.cdmn.start = [25000; 25000; 5000; 0; 0; 0; 2500; 2500; 2500; 0.1;]; % starting model 
modelInput.cdmn.step = [100; 100; 100; 1; 1; 1; 100; 100; 100; 100000;]; % initial maximium step size 
modelInput.cdmn.lower = [25000; 25000; 5000; 0; 0; 0; 2500; 2500; 2500; 0.1;]; % lower bounds on m
modelInput.cdmn.upper = [25000; 25000; 5000; 0; 0; 0; 2500; 2500; 2500; 0.1;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Simple Sphere 'B'
%                        X0  Y0  depth ax/y/z dV
modelInput.cdmb.start = [25000; 25000; 5000; 0; 0;]; % starting model 
modelInput.cdmb.step = [100; 100; 100; 100; 100000;]; % initial maximium step size 
modelInput.cdmb.lower = [25000; 25000; 5000; 0; 0;]; % lower bounds on m
modelInput.cdmb.upper = [25000; 25000; 5000; 0; 0;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Sphere 'G'
%                        X0  Y0  depth ax/y/z trd pln dV
modelInput.cdmg.start = [25000; 25000; 5000; 0; 0; 0; 2500;]; % starting model 
modelInput.cdmg.step = [100; 100; 100; 100; 1; 1; 100000;]; % initial maximium step size 
modelInput.cdmg.lower = [25000; 25000; 5000; 0; 0; 0; 2500;]; % lower bounds on m
modelInput.cdmg.upper = [25000; 25000; 5000; 0; 0; 0; 2500;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Sill 'I'
%                        X0  Y0  depth ax/y/z dV
modelInput.cdmi.start = [25000; 25000; 5000; 0; 0;]; % starting model 
modelInput.cdmi.step = [100; 100; 100; 100; 100000;]; % initial maximium step size 
modelInput.cdmi.lower = [25000; 25000; 5000; 0; 0;]; % lower bounds on m
modelInput.cdmi.upper = [25000; 25000; 5000; 0; 0;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Elongated Sill 'J'
%                        X0  Y0  depth ax ay str dV
modelInput.cdmj.start = [25000; 25000; 5000; 0; 0; 0; 0;]; % starting model 
modelInput.cdmj.step = [100; 100; 100; 100; 100; 1; 100000;]; % initial maximium step size 
modelInput.cdmj.lower = [25000; 25000; 5000; 0; 0; 0; 0;]; % lower bounds on m
modelInput.cdmj.upper = [25000; 25000; 5000; 0; 0; 0; 0;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Dyke 'K'
%                        X0  Y0  depth L W str dV
modelInput.cdmk.start = [25000; 25000; 5000; 0; 0; 0; 0;]; % starting model 
modelInput.cdmk.step = [100; 100; 100; 100; 100; 1; 100000;]; % initial maximium step size 
modelInput.cdmk.lower = [25000; 25000; 5000; 0; 0; 0; 0;]; % lower bounds on m
modelInput.cdmk.upper = [25000; 25000; 5000; 0; 0; 0; 0;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Prolate Spheroid 'L'
%                        X0  Y0  depth az AspRatio Pln Trd dV
modelInput.cdml.start = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % starting model 
modelInput.cdml.step =  [100; 100; 100; 100; 0.01; 1; 1; 100000;]; % initial maximium step size 
modelInput.cdml.lower = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % lower bounds on m
modelInput.cdml.upper = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % % upper bounds on m 

% Nikkhoo 2017 CDM Oblate Spheroid 'O'
%                        X0  Y0  depth ax AspRatio Pln Trd dV
modelInput.cdmo.start = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % starting model 
modelInput.cdmo.step =  [100; 100; 100; 100; 0.01; 1; 1; 100000;]; % initial maximium step size 
modelInput.cdmo.lower = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % lower bounds on m
modelInput.cdmo.upper = [25000; 25000; 5000; 0; 0; 0; 2500; 2500;]; % % upper bounds on m 